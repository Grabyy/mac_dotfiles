# these are for the menu
fontname "DejaVu Sans Mono:size=12"

moveamount 10	# granularity of finest movement
vtile 50
htile 75
gap 1 1 1 1
borderwidth 4
color activeborder "#89b4fa"
color inactiveborder "#313244"
snapdist 3

bind-key CM-Return	"xterm"
bind-key CM-minus	window-vtile
bind-key CMS-minus	window-htile
unbind-key CS-minus
unbind-key CS-plus
unbind-key C-slash

# applications
command terminal	"xterm"
command xclock		"xclock"
